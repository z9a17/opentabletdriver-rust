<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RollForward>LatestMajor</RollForward>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <License>LGPL-3.0-only</License>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="GraphBench" />
    <ProjectReference Include="../UpstreamDesktop/OpenTabletDriver.Desktop.csproj" />
    <ProjectReference Include="../UpstreamPlugin/OpenTabletDriver.Plugin.csproj" />
    <PackageReference Include="OpenTabletDriver.Configurations" Version="[0.6.8]" />
  </ItemGroup>
</Project>
