<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exercise the actual bridge with its pinned Core/Desktop dependencies. -->
    <ProjectReference Include="../OtdCompat/OtdCompat.csproj" />
    <PackageReference Include="OpenTabletDriver.Plugin" Version="0.6.7" />
    <PackageReference Include="OpenTabletDriver.Configurations" Version="[0.6.7]" />
  </ItemGroup>
</Project>
