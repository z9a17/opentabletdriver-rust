<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>OpenTabletDriver.Plugin</AssemblyName>
    <RootNamespace>OpenTabletDriver.Plugin</RootNamespace>
    <Version>0.6.8</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="OpenTabletDriver.Plugin.Attributes.BuildDateAttribute">
      <_Parameter1>2026-10-14</_Parameter1>
    </AssemblyAttribute>
    <PackageReference Include="JetBrains.Annotations" Version="[2025.2.4]" />
    <PackageReference Include="Newtonsoft.Json" Version="[13.0.4]" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="[5.0.0]" />
  </ItemGroup>
</Project>
